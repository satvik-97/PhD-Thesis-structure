@article{planck_collaboration_planck_2020,
	title = {Planck 2018 results. {VI}. {Cosmological} parameters},
	volume = {641},
	issn = {0004-6361, 1432-0746},
	url = {http://arxiv.org/abs/1807.06209},
	doi = {10.1051/0004-6361/201833910},
	abstract = {We present cosmological parameter results from the final full-mission Planck measurements of the CMB anisotropies. We find good consistency with the standard spatially-flat 6-parameter \${\textbackslash}Lambda\$CDM cosmology having a power-law spectrum of adiabatic scalar perturbations (denoted "base \${\textbackslash}Lambda\$CDM" in this paper), from polarization, temperature, and lensing, separately and in combination. A combined analysis gives dark matter density \${\textbackslash}Omega\_c h{\textasciicircum}2 = 0.120{\textbackslash}pm 0.001\$, baryon density \${\textbackslash}Omega\_b h{\textasciicircum}2 = 0.0224{\textbackslash}pm 0.0001\$, scalar spectral index \$n\_s = 0.965{\textbackslash}pm 0.004\$, and optical depth \${\textbackslash}tau = 0.054{\textbackslash}pm 0.007\$ (in this abstract we quote \$68{\textbackslash},{\textbackslash}\%\$ confidence regions on measured parameters and \$95{\textbackslash},{\textbackslash}\%\$ on upper limits). The angular acoustic scale is measured to \$0.03{\textbackslash},{\textbackslash}\%\$ precision, with \$100{\textbackslash}theta\_*=1.0411{\textbackslash}pm 0.0003\$. These results are only weakly dependent on the cosmological model and remain stable, with somewhat increased errors, in many commonly considered extensions. Assuming the base-\${\textbackslash}Lambda\$CDM cosmology, the inferred late-Universe parameters are: Hubble constant \$H\_0 = (67.4{\textbackslash}pm 0.5)\$km/s/Mpc; matter density parameter \${\textbackslash}Omega\_m = 0.315{\textbackslash}pm 0.007\$; and matter fluctuation amplitude \${\textbackslash}sigma\_8 = 0.811{\textbackslash}pm 0.006\$. We find no compelling evidence for extensions to the base-\${\textbackslash}Lambda\$CDM model. Combining with BAO we constrain the effective extra relativistic degrees of freedom to be \$N\_\{{\textbackslash}rm eff\} = 2.99{\textbackslash}pm 0.17\$, and the neutrino mass is tightly constrained to \${\textbackslash}sum m\_{\textbackslash}nu{\textless} 0.12\$eV. The CMB spectra continue to prefer higher lensing amplitudes than predicted in base -\${\textbackslash}Lambda\$CDM at over \$2{\textbackslash},{\textbackslash}sigma\$, which pulls some parameters that affect the lensing amplitude away from the base-\${\textbackslash}Lambda\$CDM model; however, this is not supported by the lensing reconstruction or (in models that also change the background geometry) BAO data. (Abridged)},
